---
interface Props { items: { href: string; text: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="פירורי לחם">
  <ol>
    {items.map((c, i) => (
      <li>{i < items.length - 1 ? <a href={c.href}>{c.text}</a> : <span aria-current="page">{c.text}</span>}</li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px; font-size: .92rem; }
  .crumbs li { display: flex; align-items: center; gap: 4px; color: rgb(255 255 255 / 75%); }
  .crumbs li + li::before { content: '‹'; opacity: .7; margin-inline-end: 2px; }
  .crumbs a { color: #fff; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs [aria-current] { color: rgb(255 255 255 / 85%); }
</style>
