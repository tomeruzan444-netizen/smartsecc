---
import { enhanceHtml } from '../lib/images';

interface Props { items: { q: string; a: string }[]; id?: string; title?: string | null }
const { items, id, title } = Astro.props;
---
<section class="faq" id={id} aria-label={title ?? 'שאלות ותשובות'}>
  {title && <h2>{title}</h2>}
  {items.map((f, i) => (
    <details class="faq-item" open={i === 0}>
      <summary><span>{f.q}</span></summary>
      <div class="faq-a prose" set:html={enhanceHtml(f.a)} />
    </details>
  ))}
</section>

<style>
  .faq { display: grid; gap: 10px; margin: 8px 0 28px; }
  .faq-item { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-sm); transition: box-shadow .15s; }
  .faq-item[open] { box-shadow: var(--shadow); border-color: #cfe9ef; }
  .faq-item summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 16px; align-items: center; padding: 16px 18px; font-weight: 700; color: var(--navy); }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--brand-soft); color: var(--brand-ink); font-size: 1.3rem; font-weight: 600; transition: transform .2s; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-a { padding: 0 18px 14px; color: var(--text); }
  .faq-a :global(p:last-child) { margin-bottom: 0; }
</style>
