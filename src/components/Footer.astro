---
import Icon from './Icon.astro';
import LeadForm from './LeadForm.astro';
import { SHARED } from '../lib/content';
import { SITE } from '../lib/site';
import { imgAttrs } from '../lib/images';

type Col = { title: string; links: { text: string; href: string }[] };
const [services, areas, important] = (SHARED.footer as Col[]).filter((c) => c.links.length);
const logo = imgAttrs(SITE.logo, '200px');
const bg = imgAttrs('/wp-content/uploads/2024/06/pexels-photo-430208-430208.jpg', '100vw');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <img class="f-bg" src={bg.src} srcset={bg.srcset} sizes="100vw" alt="" loading="lazy" decoding="async" />
  <div class="container grid">
    <div class="about">
      <a href="/" class="f-logo" aria-label="סמארטסק – דף הבית">
        <img src={logo.src} srcset={logo.srcset} sizes="200px" width="200" height="60" alt="סמארטסק" loading="lazy" />
      </a>
      <p>סמארטסק – {SITE.tagline}. התקנה, תיקון ותחזוקה של מצלמות אבטחה, מערכות אזעקה ואינטרקום לבית ולעסק, בפריסה ארצית.</p>
    </div>

    <nav class="col" aria-label={important.title}>
      <h2 class="ftitle">{important.title}</h2>
      <ul>{important.links.map((l) => <li><a href={l.href}>{l.text}</a></li>)}</ul>
      <h2 class="ftitle mt">{services.title.replace(':', '')}</h2>
      <ul>{services.links.map((l) => <li><a href={l.href}>{l.text}</a></li>)}</ul>
    </nav>

    <nav class="col" aria-label={areas.title}>
      <h2 class="ftitle">{areas.title}</h2>
      <ul class="two">{areas.links.map((l) => <li><a href={l.href}>{l.text}</a></li>)}</ul>
    </nav>

    <div class="col">
      <h2 class="ftitle">פרטים ליצירת קשר</h2>
      <ul class="contact">
        <li><Icon name="phone" /><span>טלפון: <a href={SITE.phoneHref}>{SITE.phone}</a></span></li>
        <li><Icon name="mail" /><span>אימייל: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></span></li>
        <li><Icon name="clock" /><span>שעות פעילות: {SITE.openingHoursText}</span></li>
        <li><Icon name="pin" /><span>שירות בפריסה ארצית</span></li>
      </ul>
    </div>

    <div class="col form-col">
      <LeadForm variant="footer" />
    </div>
  </div>
  <div class="container bottom">
    <p>© {year} כל הזכויות שמורות לסמארטסק</p>
    <p><a href="/מדיניות-פרטיות/">מדיניות פרטיות</a> | <a href="/הצהרת-נגישות/">הצהרת נגישות</a></p>
    <p class="credit">
      האתר נבנה ומנוהל באהבה על ידי <a href="https://brandli.co.il/websites-for-doctors/" target="_blank" rel="noopener">ברנדלי</a>
      <span class="credit-logo"><img src="/brand/brandli-logo.webp" width="382" height="112" alt="לוגו ברנדלי" loading="lazy" decoding="async" /></span>
    </p>
  </div>
</footer>

<style>
  .site-footer { position: relative; isolation: isolate; background: var(--dark); color: #d5dde5; margin-top: 64px; border-top: 4px solid var(--brand); overflow: hidden; }
  .f-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .12; z-index: -1; filter: grayscale(1); }
  .grid { display: grid; grid-template-columns: 1.3fr 1fr 1.3fr 1.1fr 1.1fr; gap: 32px; padding-block: 52px 32px; }
  .f-logo { display: inline-block; background: #fff; padding: 14px 16px; border-radius: 6px; margin-bottom: 16px; }
  .f-logo img { width: 170px; height: auto; }
  .about p { margin: 0; line-height: 1.75; }
  .ftitle { color: #fff; font-size: 1.15rem; margin: 0 0 .8em; }
  .ftitle.mt { margin-top: 1.4em; }
  .col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .col ul.two { grid-template-columns: 1fr 1fr; column-gap: 14px; }
  .col a { color: #d5dde5; text-decoration: none; }
  .col a:hover { color: #fff; text-decoration: underline; }
  .contact { gap: 10px !important; }
  .contact li { display: flex; gap: 10px; align-items: flex-start; }
  .contact :global(svg) { width: 18px; height: 18px; color: var(--brand); flex: none; margin-top: 4px; }
  .bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; border-top: 1px solid rgb(255 255 255 / 14%); padding-block: 16px 20px; font-size: .92rem; }
  .bottom p { margin: 0; }
  .bottom a { color: #d5dde5; }
  .credit { flex-basis: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: .82rem; color: #aab6c2; }
  .credit a { color: #fff; font-weight: 700; }
  /* the logo has dark text on transparent – a small white chip keeps it readable on the dark footer */
  .credit-logo { display: inline-flex; background: #fff; border-radius: 4px; padding: 2px 6px; }
  .credit-logo img { width: 72px; height: auto; }
  @media (max-width: 1100px) { .grid { grid-template-columns: 1fr 1fr 1fr; } .about { grid-column: 1 / -1; } }
  @media (max-width: 700px) { .grid { grid-template-columns: 1fr; } .site-footer { padding-bottom: 72px; } }
</style>
