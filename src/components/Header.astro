---
import Icon from './Icon.astro';
import { SHARED } from '../lib/content';
import { SITE } from '../lib/site';
import { imgAttrs } from '../lib/images';

const current = decodeURI(Astro.url.pathname);
const menu = SHARED.menu as { text: string; href: string; children: { text: string; href: string }[] }[];
const isActive = (item: { href: string; children?: { href: string }[] }) =>
  current === item.href || !!item.children?.some((c) => c.href === current);
const logo = imgAttrs(SITE.logo, '160px');
// WordPress menu labels are long ("... – התקנה בבית פרטי ובעסק"); keep the head of the label in the bar
const short = (t: string) => t.split(/\s+[–-]\s+/)[0];
---
<header class="site-header" id="top">
  <div class="container bar">
    <a href="/" class="logo" aria-label="סמארטסק – דף הבית">
      <img src={logo.src} srcset={logo.srcset} sizes="160px" width="160" height="48" alt="סמארטסק" fetchpriority="high" />
    </a>

    <nav class="nav" id="site-nav" aria-label="ניווט ראשי">
      <ul class="menu">
        {menu.map((item, i) => (
          <li class:list={['menu-item', { 'has-sub': item.children.length, active: isActive(item) }]}>
            <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{short(item.text)}</a>
            {item.children.length > 0 && (
              <>
                <button class="sub-toggle" type="button" aria-expanded="false" aria-controls={`sub-${i}`}>
                  <span class="visually-hidden">פתח תת תפריט {short(item.text)}</span>
                  <Icon name="chev" />
                </button>
                <ul class="sub" id={`sub-${i}`}>
                  <li><a href={item.href}>{item.text}</a></li>
                  {item.children.map((c) => (
                    <li><a href={c.href} aria-current={current === c.href ? 'page' : undefined}>{c.text}</a></li>
                  ))}
                </ul>
              </>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a class="phone" href={SITE.phoneHref} aria-label={`להזמנות חייגו ${SITE.phone}`}>
      <span class="phone-ico"><Icon name="phone" /></span>
      <span class="phone-txt"><small>להזמנות חייגו</small><strong>{SITE.phone}</strong></span>
    </a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="site-nav">
      <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
      <span class="visually-hidden">תפריט</span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header')!;
  const burger = header.querySelector<HTMLButtonElement>('.burger')!;
  burger.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') !== 'true';
    burger.setAttribute('aria-expanded', String(open));
    header.classList.toggle('open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  });
  header.querySelectorAll<HTMLButtonElement>('.sub-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      header.querySelectorAll('.sub-toggle').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      btn.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    header.querySelectorAll('.sub-toggle').forEach((b) => b.setAttribute('aria-expanded', 'false'));
    if (header.classList.contains('open')) burger.click();
  });
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--blue); color: #fff; transition: box-shadow .2s; }
  .site-header.scrolled { box-shadow: 0 6px 20px rgb(0 0 0 / 22%); }
  .bar { display: flex; align-items: center; gap: 24px; height: var(--header-h); }
  /* logo sits in a white tile that hangs below the bar, like a badge */
  .logo { align-self: flex-start; margin-top: 10px; background: #fff; border-radius: 16px; padding: 12px 14px; box-shadow: 0 8px 24px rgb(0 0 0 / 18%); flex: none; position: relative; z-index: 2; }
  .logo img { width: 132px; height: auto; }
  .nav { flex: 1; display: flex; justify-content: center; }
  .menu { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 2px; }
  .menu-item { position: relative; display: flex; align-items: center; }
  .menu-item > a { padding: 24px 9px; color: #fff; font-weight: 700; text-decoration: none; white-space: nowrap; font-size: 1.02rem; border-bottom: 3px solid transparent; }
  .menu-item > a:hover, .menu-item.active > a { border-bottom-color: var(--brand); }
  .menu-item.active > a { color: #e3f9fd; }
  /* ≥24px tap target with clear spacing from the link (WCAG 2.2 target-size) */
  .sub-toggle { border: 0; background: none; width: 28px; height: 36px; padding: 0; margin-inline-start: 0; border-radius: 6px; color: #fff; cursor: pointer; display: grid; place-items: center; }
  .sub-toggle:hover { background: rgb(255 255 255 / 12%); }
  .sub-toggle :global(svg) { width: 18px; height: 18px; transition: transform .2s; }
  .sub { position: absolute; top: 100%; inset-inline-start: 0; min-width: 280px; list-style: none; margin: 0; padding: 8px; background: #fff; border-top: 3px solid var(--brand); border-radius: 0 0 12px 12px; box-shadow: 0 14px 34px rgb(0 0 0 / 18%); opacity: 0; visibility: hidden; transform: translateY(6px); transition: .16s; }
  .sub a { display: block; padding: 9px 12px; border-radius: 8px; color: var(--text); text-decoration: none; font-weight: 600; }
  .sub a:hover, .sub a[aria-current='page'] { background: var(--brand-soft); color: var(--blue-dark); }
  .sub li:first-child a { font-weight: 800; color: var(--blue-dark); }
  .has-sub:hover .sub, .has-sub:focus-within .sub, .sub-toggle[aria-expanded='true'] + .sub { opacity: 1; visibility: visible; transform: none; }
  .has-sub:hover .sub-toggle :global(svg), .sub-toggle[aria-expanded='true'] :global(svg) { transform: rotate(180deg); }
  .phone { display: flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; flex: none; }
  .phone:hover { color: #fff; }
  .phone-ico { width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--green); color: var(--green); display: grid; place-items: center; background: rgb(255 255 255 / 8%); }
  .phone-ico :global(svg) { width: 22px; height: 22px; }
  .phone-txt { display: grid; line-height: 1.15; }
  .phone-txt small { font-size: .9rem; font-weight: 700; }
  .phone-txt strong { font-size: 1.3rem; font-weight: 800; letter-spacing: .02em; direction: ltr; }
  .burger { display: none; border: 0; background: rgb(255 255 255 / 14%); color: #fff; width: 46px; height: 46px; border-radius: 12px; cursor: pointer; place-items: center; }
  .burger :global(svg) { width: 26px; height: 26px; }
  .burger :global(.i-close), .open .burger :global(.i-open) { display: none; }
  .open .burger :global(.i-close) { display: block; }

  @media (max-width: 1240px) {
    .menu-item > a { padding: 24px 6px; font-size: .95rem; }
    .phone-txt small { display: none; }
  }
  @media (max-width: 1060px) {
    .burger { display: grid; }
    .bar { gap: 12px; }
    .logo { align-self: center; margin-top: 0; padding: 6px 10px; border-radius: 12px; }
    .logo img { width: 110px; }
    .phone { margin-inline-start: auto; }
    .nav { position: fixed; inset: var(--header-h) 0 0 0; background: #fff; flex-direction: column; justify-content: flex-start; padding: 16px 16px 120px; overflow-y: auto; transform: translateX(100%); visibility: hidden; transition: transform .25s, visibility .25s; }
    .open .nav { transform: none; visibility: visible; }
    .menu { flex-direction: column; align-items: stretch; gap: 0; }
    .menu-item { flex-wrap: wrap; border-bottom: 1px solid var(--line); }
    .menu-item > a { flex: 1; padding: 14px 6px; font-size: 1.1rem; color: var(--blue-dark); border: 0; }
    .sub-toggle { width: 48px; height: 48px; margin: 0; color: var(--blue-dark); }
    .sub { position: static; width: 100%; box-shadow: none; border: 0; padding: 0 0 10px; opacity: 1; visibility: visible; transform: none; display: none; }
    .sub-toggle[aria-expanded='true'] + .sub { display: block; }
    .has-sub:hover .sub { display: none; }
    .has-sub:hover .sub-toggle[aria-expanded='true'] + .sub { display: block; }
  }
  @media (max-width: 480px) {
    .phone-txt { display: none; }
  }
</style>
