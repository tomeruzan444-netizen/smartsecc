---
// Full-width photo hero with the page H1 and a horizontal lead form bar along its bottom edge.
import Breadcrumbs from './Breadcrumbs.astro';
import LeadForm from './LeadForm.astro';
import { breadcrumbs, heroImage, type Page } from '../lib/content';
import { imgAttrs } from '../lib/images';

interface Props { page: Page; tagline?: string }
const { page, tagline } = Astro.props;
const img = imgAttrs(heroImage(page), '100vw');
const isHome = page.type === 'home';
const [main, ...rest] = page.h1.split(/\s+[–-]\s+/);
// skip a subtitle that only repeats the heading
const sub = tagline ?? (page.subtitle && !page.h1.includes(page.subtitle.split(' ').slice(0, 3).join(' ')) ? page.subtitle : '');
---
<section class:list={['hero', { 'hero-home': isHome }]}>
  <img class="hero-bg" src={img.src} srcset={img.srcset} sizes="100vw" width={img.width} height={img.height} alt="" fetchpriority="high" decoding="async" />
  <div class="container hero-copy">
    {!isHome && <Breadcrumbs items={breadcrumbs(page)} />}
    <h1>
      <span class="h1-main">{main}</span>
      {rest.length > 0 && <span class="h1-rest">{rest.join(' – ')}</span>}
    </h1>
    {sub && <p class="hero-sub">{sub}</p>}
  </div>
  <div class="hero-bar">
    <div class="container">
      <LeadForm variant="bar" city={page.city} />
    </div>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; background: #dfe8f1; min-height: 420px; display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
  .hero-home { min-height: 520px; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: left center; z-index: -2; }
  /* light wash from the text side (right in RTL) so the dark-blue heading stays readable */
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(270deg, rgb(236 242 248 / 96%) 0%, rgb(236 242 248 / 88%) 42%, rgb(236 242 248 / 30%) 75%, rgb(236 242 248 / 0%) 100%); }
  .hero-copy { padding-block: 48px 40px; flex: 1; display: flex; flex-direction: column; justify-content: center; }
  .hero-copy :global(.crumbs li), .hero-copy :global(.crumbs a), .hero-copy :global(.crumbs [aria-current]) { color: var(--blue-dark); }
  h1 { margin: 10px 0 8px; color: var(--blue-dark); max-width: 760px; }
  .h1-main { display: block; font-size: clamp(2rem, 1.3rem + 2.6vw, 3.3rem); font-weight: 800; line-height: 1.12; }
  .h1-rest { display: block; font-size: clamp(1.3rem, 1rem + 1.2vw, 2rem); font-weight: 700; color: var(--blue); margin-top: 6px; }
  .hero-sub { font-size: 1.3rem; font-weight: 700; color: var(--text); margin: 0; max-width: 640px; }
  .hero-bar { background: rgb(84 89 95 / 88%); backdrop-filter: blur(4px); padding-block: 14px; }
  @media (max-width: 760px) {
    .hero, .hero-home { min-height: 0; }
    .hero::before { background: rgb(236 242 248 / 88%); }
    .hero-copy { padding-block: 24px 22px; }
    .hero-sub { font-size: 1.1rem; }
  }
</style>
