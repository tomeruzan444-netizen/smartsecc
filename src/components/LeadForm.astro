---
import Icon from './Icon.astro';
import { SITE } from '../lib/site';

interface Props { title?: string; id?: string; city?: string | null; compact?: boolean }
const { title = 'השאירו פרטים ונחזור אליכם', id = 'lead-form', city, compact = false } = Astro.props;
const uid = id.replace(/[^a-z0-9-]/gi, '');
---
<form class:list={['lead card', { compact }]} id={id} action={SITE.formEndpoint} method="post" data-lead novalidate>
  <h2 class="lead-title">{title}</h2>
  <p class="lead-sub">הצעת מחיר חינם וללא התחייבות · חוזרים אליכם במהירות</p>
  <div class="fields">
    <div class="field">
      <label for={`${uid}-name`}>שם</label>
      <input class="input" id={`${uid}-name`} name="name" autocomplete="name" required maxlength="80" />
    </div>
    <div class="field">
      <label for={`${uid}-phone`}>מספר טלפון</label>
      <input class="input" id={`${uid}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel" required pattern="[0-9+\-\s]{9,15}" dir="ltr" />
    </div>
    <div class="field">
      <label for={`${uid}-city`}>עיר</label>
      <input class="input" id={`${uid}-city`} name="city" autocomplete="address-level2" required maxlength="60" value={city ?? undefined} />
    </div>
    <div class="field wide">
      <label for={`${uid}-msg`}>איך נוכל לעזור?</label>
      <textarea class="input" id={`${uid}-msg`} name="message" required maxlength="1500" rows="3"></textarea>
    </div>
  </div>
  <div class="hp" aria-hidden="true">
    <label>אתר <input name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <input type="hidden" name="ts" value="" data-ts />
  <label class="consent">
    <input type="checkbox" name="consent" value="1" required />
    <span>אני מאשר/ת כי ידוע לי שהפרטים שמסרתי יעובדו בהתאם לחוק הגנת הפרטיות. לפרטים נוספים: <a href="/מדיניות-פרטיות/">מדיניות פרטיות</a></span>
  </label>
  <button class="btn btn-cta submit" type="submit"><Icon name="send" />שלחו ונחזור אליכם</button>
  <p class="status" role="status" aria-live="polite"></p>
  <p class="or">או התקשרו עכשיו: <a href={SITE.phoneHref}>{SITE.phone}</a></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-lead]').forEach((form) => {
    const ts = form.querySelector<HTMLInputElement>('[data-ts]');
    if (ts) ts.value = String(Date.now());
    const status = form.querySelector<HTMLElement>('.status')!;
    const btn = form.querySelector<HTMLButtonElement>('.submit')!;
    // result of a no-JS submission redirected back by contact.php
    const sent = new URLSearchParams(location.search).get('sent');
    if (sent && form.id === 'lead-form') {
      status.textContent = sent === '1' ? 'תודה! הפרטים התקבלו ונחזור אליכם בהקדם.' : 'לא הצלחנו לשלוח כרגע. אפשר להתקשר אלינו ישירות: 03-3769229';
      status.dataset.state = sent === '1' ? 'ok' : 'error';
    }
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.classList.add('touched');
        status.textContent = 'נא למלא את כל השדות ולאשר את מדיניות הפרטיות.';
        status.dataset.state = 'error';
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }
      btn.disabled = true;
      status.textContent = 'שולחים…';
      status.dataset.state = '';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || 'send failed');
        form.reset();
        status.textContent = 'תודה! הפרטים התקבלו ונחזור אליכם בהקדם.';
        status.dataset.state = 'ok';
      } catch {
        status.textContent = 'לא הצלחנו לשלוח כרגע. אפשר להתקשר אלינו ישירות: 03-3769229';
        status.dataset.state = 'error';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  .lead { padding: 24px; display: grid; gap: 12px; scroll-margin-top: calc(var(--header-h) + 16px); }
  .lead-title { font-size: 1.4rem; margin: 0; }
  .lead-sub { margin: -6px 0 4px; color: var(--muted); font-size: .95rem; }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .fields .wide { grid-column: 1 / -1; }
  .compact .fields { grid-template-columns: 1fr; }
  .touched .input:invalid { border-color: #c2410c; }
  .hp { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }
  .consent { display: flex; gap: 10px; align-items: flex-start; font-size: .85rem; color: var(--muted); line-height: 1.5; }
  .consent input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--brand-ink); flex: none; }
  .submit { width: 100%; }
  .submit:disabled { opacity: .7; cursor: progress; }
  .status { margin: 0; font-weight: 650; min-height: 0; }
  .status:empty { display: none; }
  .status[data-state='ok'] { color: var(--cta); }
  .status[data-state='error'] { color: #b42318; }
  .or { margin: 0; text-align: center; font-size: .95rem; color: var(--muted); }
  .or a { font-weight: 750; }
  @media (max-width: 480px) { .fields { grid-template-columns: 1fr; } .lead { padding: 18px; } }
</style>
