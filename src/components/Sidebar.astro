---
import Icon from './Icon.astro';
import Toc from './Toc.astro';
import { sidebarFor, type Page } from '../lib/content';
import { SITE } from '../lib/site';

interface Props { page: Page }
const { page } = Astro.props;
const { groups } = sidebarFor(page);
const current = page.path;
---
<aside class="sidebar" aria-label="קישורים רלוונטיים">
  {groups.map((g) => (
    <nav class="box" aria-label={g.title}>
      <p class="box-title">{g.title}</p>
      <ul>
        {g.links.map((l) => (
          <li><a href={l.href} aria-current={l.href === current ? 'page' : undefined}><Icon name="chev" />{l.text}</a></li>
        ))}
      </ul>
      {g.more && <a class="more" href={g.more.href}>{g.more.text} &gt;&gt;</a>}
    </nav>
  ))}

  <div class="sticky">
    <div class="call">
      <p class="call-title">להזמנות חייגו</p>
      <a class="call-num" href={SITE.phoneHref}><Icon name="phone" />{SITE.phone}</a>
      <p class="call-text">הצעת מחיר חינם · {SITE.openingHoursText}</p>
      <a class="btn btn-cta" href="#lead-form">תנו לי הצעה!</a>
    </div>
    <Toc items={page.toc} variant="side" />
  </div>
</aside>

<style>
  .sidebar { display: grid; gap: 20px; align-content: start; }
  .box { background: #fff; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; box-shadow: 0 1px 3px rgb(0 0 0 / 5%); }
  .box-title { margin: 0; padding: 12px 16px; background: var(--blue); color: #fff; font-weight: 800; font-size: 1.05rem; border-bottom: 3px solid var(--brand); }
  .box ul { list-style: none; margin: 0; padding: 6px 0; max-height: 380px; overflow-y: auto; }
  .box li + li { border-top: 1px dotted #c9d1d9; }
  .box a { display: flex; align-items: center; gap: 6px; padding: 9px 14px; color: var(--text); text-decoration: none; font-size: .96rem; line-height: 1.4; }
  .box a :global(svg) { width: 16px; height: 16px; color: var(--brand-ink); flex: none; transform: rotate(90deg); }
  .box a:hover { background: var(--brand-soft); color: var(--blue-dark); }
  .box a[aria-current='page'] { font-weight: 800; color: var(--blue-dark); }
  .more { display: block; padding: 10px 16px 14px; font-weight: 800; color: var(--cta); text-decoration: none; }
  .more:hover { color: var(--cta-hover); text-decoration: underline; }
  .sticky { position: sticky; top: calc(var(--header-h) + 16px); display: grid; gap: 20px; }
  .call { background: var(--gray); color: #fff; border-radius: 6px; padding: 20px; display: grid; gap: 8px; text-align: center; }
  .call-title { margin: 0; font-weight: 800; font-size: 1.15rem; }
  .call-num { display: inline-flex; justify-content: center; align-items: center; gap: 8px; color: #fff; font-size: 1.7rem; font-weight: 800; text-decoration: none; direction: ltr; }
  .call-num :global(svg) { width: 26px; height: 26px; color: var(--green); }
  .call-text { margin: 0 0 4px; color: #e6eaee; font-size: .92rem; }
  .call .btn { border-radius: 4px; }
  @media (max-width: 1024px) {
    .sidebar { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
    .sticky { position: static; }
    .sticky :global(.toc-side) { display: none; }
  }
</style>
