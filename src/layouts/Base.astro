---
import '@fontsource-variable/assistant';
import fontHebrew from '@fontsource-variable/assistant/files/assistant-hebrew-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import CookieNotice from '../components/CookieNotice.astro';
import { SITE, absUrl } from '../lib/site';
import { pageSchema } from '../lib/schema';
import type { Page } from '../lib/content';

interface Props { page?: Page; title?: string; description?: string; robots?: string; path?: string }
const { page } = Astro.props;
// Head values are copied verbatim from Rank Math so titles/snippets in Google stay the same
const title = page?.title ?? Astro.props.title ?? SITE.name;
const description = page?.description ?? Astro.props.description ?? '';
const robots = page?.robots ?? Astro.props.robots ?? 'index, follow';
const path = page?.canonical ?? page?.path ?? Astro.props.path ?? Astro.url.pathname;
const canonical = absUrl(path);
const ogImage = page?.ogImage ? absUrl(page.ogImage) : absUrl('/wp-content/uploads/2024/06/סמארטסק-1024x484.png');
const schema = page ? pageSchema(page) : null;
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    <meta name="theme-color" content="#0b2540" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:locale" content="he_IL" />
    <meta property="og:type" content={page?.ogType || 'website'} />
    <meta property="og:title" content={page?.ogTitle || title} />
    {(page?.ogDescription || description) && <meta property="og:description" content={page?.ogDescription || description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.nameEn} />
    <meta property="og:image" content={ogImage} />
    {page?.modified && <meta property="og:updated_time" content={page.modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page?.ogTitle || title} />
    {(page?.ogDescription || description) && <meta name="twitter:description" content={page?.ogDescription || description} />}
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/wp-content/uploads/2024/06/cropped-אייקון-סמארטסק-min-32x32.png" sizes="32x32" />
    <link rel="icon" href="/wp-content/uploads/2024/06/cropped-אייקון-סמארטסק-min-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/wp-content/uploads/2024/06/cropped-אייקון-סמארטסק-min-180x180.png" />
    <link rel="preload" href={fontHebrew} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" type="application/xml" href="/sitemap_index.xml" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">דילוג לתוכן הראשי</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <CookieNotice />
  </body>
</html>
